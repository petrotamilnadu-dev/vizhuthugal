<!DOCTYPE html>
<html lang="ta">
<head>
  <%- include('partials/head', { pageTitle: article.title }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="container article-page">
    <article>
      <% if (article.category_name) { %>
        <a href="/category/<%= article.category_slug %>" class="card-tag"><%= article.category_name %></a>
      <% } %>
      <h1><%= article.title %></h1>
      <div class="article-meta">
        <time><%= new Date(article.created_at).toLocaleDateString('ta-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
      </div>

      <div class="share-bar">
        <span class="share-label">பகிரவும்:</span>
        <a href="https://wa.me/?text=<%= encodeURIComponent(article.title + ' - ' + decodeURIComponent(CURRENT_URL)) %>" target="_blank" rel="noopener" class="share-icon share-whatsapp" aria-label="WhatsApp-ல் பகிர">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.87 9.87 0 004.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.35-.5.05-1.06.24-3.58-.74-3.01-1.19-4.93-4.24-5.08-4.44-.15-.2-1.22-1.62-1.22-3.09s.77-2.19 1.04-2.49c.27-.3.6-.37.8-.37.2 0 .4 0 .58.01.19.01.44-.07.68.53.25.61.85 2.11.93 2.26.08.15.13.33.02.53-.1.2-.15.33-.3.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.33 2.38 1.48.3.15.47.13.64-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.27.1 1.75.82 2.05.97.3.15.5.23.57.35.08.13.08.72-.16 1.4z"/></svg>
        </a>
        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(decodeURIComponent(CURRENT_URL)) %>" target="_blank" rel="noopener" class="share-icon share-facebook" aria-label="Facebook-ல் பகிர">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.4-3H13.5V8.5c0-.87.24-1.46 1.5-1.46h1.6V4.35C16.3 4.24 15.4 4 14.37 4c-2.15 0-3.62 1.31-3.62 3.72V10.5H8.25v3H10.75V21h2.75z"/></svg>
        </a>
        <button type="button" class="share-icon share-copy" onclick="shareCopyLink(this)" aria-label="Link-ஐ copy செய்">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 14a5 5 0 007.07 0l2-2a5 5 0 00-7.07-7.07l-1 1"/><path d="M14 10a5 5 0 00-7.07 0l-2 2a5 5 0 007.07 7.07l1-1"/></svg>
        </button>
      </div>

      <% if (article.image) { %>
        <img class="article-image" src="<%= article.image %>" alt="<%= article.title %>">
      <% } %>
      <div class="article-content">
        <%- renderContentWithImages(article.content, galleryImages) %>
      </div>

      <% if (relatedVideo) { %>
        <div class="related-video">
          <h2 class="related-video-title">&#9654;&#65039; தொடர்புடைய வீடியோ</h2>
          <div class="featured-video" onclick="vmOpenModal('<%= relatedVideo.videoId %>')">
            <div class="featured-video-thumb">
              <img src="<%= relatedVideo.thumbnail %>" alt="<%= relatedVideo.title %>">
              <span class="play-btn">&#9658;</span>
            </div>
            <% if (relatedVideo.title) { %><h3><%= relatedVideo.title %></h3><% } %>
          </div>
        </div>
      <% } %>
    </article>

    <%- include('partials/banner', { banner: banner }) %>

    <section class="comments-section" id="comments">
      <h2 class="section-title">கருத்துகள் (<%= comments.length %>)</h2>

      <% if (commented === 'posted') { %>
        <div class="alert alert-success">உங்கள் கருத்து பதிவு செய்யப்பட்டது!</div>
      <% } else if (commented === 'blocked') { %>
        <div class="alert alert-error">உங்கள் கருத்து மதிப்பாய்வுக்காக வைக்கப்பட்டுள்ளது.</div>
      <% } %>

      <% if (comments.length === 0) { %>
        <p class="hint">முதல் கருத்தை பதிவு செய்யுங்கள்.</p>
      <% } else { %>
        <div class="comment-list">
          <% comments.forEach(function(c) { %>
            <div class="comment-item">
              <div class="comment-item-head">
                <span class="comment-name"><%= c.name %></span>
                <span class="comment-date"><%= new Date(c.created_at).toLocaleDateString('ta-IN') %></span>
              </div>
              <p class="comment-text"><%= c.comment %></p>
            </div>
          <% }); %>
        </div>
      <% } %>

      <form method="post" action="/news/<%= article.slug %>/comment" class="comment-form">
        <label>பெயர்</label>
        <input type="text" name="name" required maxlength="80" placeholder="உங்கள் பெயர்">
        <label>கருத்து</label>
        <textarea name="comment" rows="4" required maxlength="1000" placeholder="உங்கள் கருத்தை பதிவு செய்யுங்கள்..."></textarea>
        <button type="submit" class="btn btn-primary">கருத்தை பதிவிடு</button>
      </form>
    </section>

    <% if (related.length) { %>
      <h2 class="section-title">தொடர்புடைய செய்திகள்</h2>
      <div class="article-grid">
        <% related.forEach(function(a) { %>
          <%- include('partials/article-card', { a }) %>
        <% }); %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <%- include('partials/video-modal') %>
  <script>
    function shareCopyLink(btn) {
      // window.location.href is percent-encoded (ugly for Tamil URLs) —
      // decode it so the copied link is clean, readable Tamil text.
      var cleanUrl = decodeURIComponent(window.location.href);
      navigator.clipboard.writeText(cleanUrl).then(function () {
        var original = btn.innerHTML;
        btn.innerHTML = '&#10003;';
        setTimeout(function () { btn.innerHTML = original; }, 1500);
      });
    }
  </script>
</body>
</html>
