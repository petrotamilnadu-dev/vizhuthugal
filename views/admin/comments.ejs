<!DOCTYPE html>
<html lang="ta">
<head>
  <%- include('../partials/head', { pageTitle: 'Comments' }) %>
</head>
<body class="admin-body">
  <%- include('../partials/admin-nav', { active: 'comments' }) %>

  <main class="container admin-main">
    <h1>Comments (<%= comments.length %>)</h1>
    <p class="hint">
      Readers comment போட்ட உடனே அது automatic-ஆ site-ல் தெரியும் (approve
      பண்ண தேவையில்லை). கீழே கொடுக்கிற "Banned Words" list-ல் இருக்கிற
      வார்த்தை எதுவும் comment-ல் இருந்தா, அது automatic-ஆ blocked-ஆகி
      (site-ல் தெரியாம) இங்க pending-ஆ காட்டப்படும் — நீங்க பாத்து
      Approve/Delete பண்ணலாம். வேணும்-ன்னா எந்த comment-ஐயும் எப்பொழுது
      வேணும்னாலும் delete பண்ணலாம்.
    </p>

    <% if (saved) { %><div class="alert alert-success"><%= saved %></div><% } %>

    <form method="post" action="/admin/comments/banned-words" class="admin-form" style="max-width:500px; margin-bottom:32px;">
      <label>Banned Words (comma அல்லது புதிய வரியில் பிரிக்கவும்)</label>
      <textarea name="banned_words" rows="3" placeholder="e.g. வார்த்தை1, வார்த்தை2"><%= bannedWords %></textarea>
      <p class="hint">இதுல இருக்கிற வார்த்தை comment-ல் (பெயர் அல்லது message-ல்) இருந்தா, அது automatic-ஆ block ஆகும்.</p>
      <button type="submit" class="btn btn-primary">சேமி</button>
    </form>

    <% if (comments.length === 0) { %>
      <div class="empty-state"><p>இன்னும் comments இல்லை.</p></div>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>பெயர்</th>
            <th>Comment</th>
            <th>செய்தி</th>
            <th>நிலை</th>
            <th>தேதி</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% comments.forEach(function(c) { %>
            <tr>
              <td><%= c.name %></td>
              <td style="max-width:280px; white-space:normal;"><%= c.comment %></td>
              <td><a href="/news/<%= c.article_slug %>" target="_blank"><%= c.article_title %></a></td>
              <td>
                <% if (c.approved) { %><span class="badge badge-live">வெளியிடப்பட்டது</span>
                <% } else { %><span class="badge badge-draft">&#128683; Blocked</span><% } %>
              </td>
              <td><%= new Date(c.created_at).toLocaleDateString('ta-IN') %></td>
              <td class="admin-row-actions">
                <% if (!c.approved) { %>
                  <form method="post" action="/admin/comments/<%= c.id %>/approve">
                    <button type="submit" class="link-danger" style="color:#1e6b35">Approve</button>
                  </form>
                <% } %>
                <form method="post" action="/admin/comments/<%= c.id %>/delete" onsubmit="return confirm('இந்த comment-ஐ நீக்கவா?')">
                  <button type="submit" class="link-danger">நீக்க</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
