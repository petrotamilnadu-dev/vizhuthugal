<!DOCTYPE html>
<html lang="ta">
<head>
  <%- include('../partials/head', { pageTitle: 'கடவுச்சொல் மாற்ற' }) %>
</head>
<body class="admin-body">
  <%- include('../partials/admin-nav', { active: 'password' }) %>

  <main class="container admin-main">
    <h1>கடவுச்சொல் மாற்ற</h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <form method="post" action="/admin/password" class="admin-form" style="max-width:420px">
      <label>தற்போதைய கடவுச்சொல்</label>
      <input type="password" name="current_password" required>
      <label>புதிய கடவுச்சொல்</label>
      <input type="password" name="new_password" required minlength="6">
      <label>புதிய கடவுச்சொல் (மீண்டும்)</label>
      <input type="password" name="confirm_password" required minlength="6">
      <button type="submit" class="btn btn-primary">மாற்று</button>
    </form>
  </main>
</body>
</html>
