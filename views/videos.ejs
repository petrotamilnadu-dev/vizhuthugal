<!DOCTYPE html>
<html lang="ta">
<head>
  <%- include('partials/head', { pageTitle: 'வீடியோக்கள்' }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <h1 class="section-title">வீடியோக்கள்</h1>

    <% if (!videos || videos.length === 0) { %>
      <div class="empty-state">
        <p>இன்னும் வீடியோக்கள் இல்லை. Admin panel-ல் YouTube channel connect பண்ணினா இங்க தானாகவே தெரியும்.</p>
      </div>
    <% } else { %>
      <div class="video-grid">
        <% videos.forEach(function(v) { %>
          <div class="video-card">
            <div class="video-thumb" onclick="vmOpenModal('<%= v.videoId %>')">
              <% if (v.thumbnail) { %><img src="<%= v.thumbnail %>" alt="<%= v.title %>" loading="lazy"><% } else { %><div class="card-img-placeholder"></div><% } %>
              <span class="play-btn">&#9658;</span>
            </div>
            <h3><%= v.title %></h3>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>

  <div class="video-modal-overlay" id="videoModalOverlay" onclick="if (event.target === this) vmCloseModal()">
    <div class="video-modal">
      <button type="button" class="video-modal-close" onclick="vmCloseModal()" aria-label="Close">&times;</button>
      <iframe id="videoModalIframe" src="" title="YouTube video" frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  </div>

  <script>
    function vmOpenModal(id) {
      var overlay = document.getElementById('videoModalOverlay');
      var iframe = document.getElementById('videoModalIframe');
      iframe.src = 'https://www.youtube.com/embed/' + id + '?autoplay=1';
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function vmCloseModal() {
      var overlay = document.getElementById('videoModalOverlay');
      var iframe = document.getElementById('videoModalIframe');
      overlay.classList.remove('open');
      iframe.src = '';
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') vmCloseModal();
    });
  </script>
</body>
</html>
