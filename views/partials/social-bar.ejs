<% var hasHeadlines = typeof LATEST_HEADLINES !== 'undefined' && LATEST_HEADLINES && LATEST_HEADLINES.length > 0; %>
<% var hasSocial = SOCIAL_INSTAGRAM || SOCIAL_FACEBOOK || SOCIAL_YOUTUBE; %>
<% if (hasHeadlines || hasSocial) { %>
<div class="info-belt">
  <div class="container info-belt-inner">
    <% if (hasHeadlines) { %>
      <div class="headline-ticker">
        <span class="headline-ticker-label">செய்திகள்</span>
        <div class="headline-ticker-viewport" id="headlineTicker">
          <% LATEST_HEADLINES.forEach(function(h, i) { %>
            <a href="/news/<%= h.slug %>" class="headline-ticker-item<%= i === 0 ? ' active' : '' %>"><%= h.title %></a>
          <% }); %>
        </div>
      </div>
    <% } else { %>
      <span></span>
    <% } %>

    <% if (hasSocial) { %>
      <div class="social-icons">
        <% if (SOCIAL_INSTAGRAM) { %>
          <a href="<%= SOCIAL_INSTAGRAM %>" target="_blank" rel="noopener" class="social-icon social-instagram" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor"/></svg>
          </a>
        <% } %>
        <% if (SOCIAL_FACEBOOK) { %>
          <a href="<%= SOCIAL_FACEBOOK %>" target="_blank" rel="noopener" class="social-icon social-facebook" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="none"><path d="M15 8.5h2V5.2c-.35-.05-1.53-.15-2.9-.15-2.87 0-4.83 1.8-4.83 5.1V13H6.8v3.6h2.47V22h3.6v-5.4h2.6l.4-3.6h-3V10.5c0-1.04.28-1.75 1.73-1.75z" fill="currentColor"/></svg>
          </a>
        <% } %>
        <% if (SOCIAL_YOUTUBE) { %>
          <a href="<%= SOCIAL_YOUTUBE %>" target="_blank" rel="noopener" class="social-icon social-youtube" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="5.5" width="20" height="13" rx="4" stroke="currentColor" stroke-width="1.8"/><path d="M10.5 9.5l5 2.5-5 2.5z" fill="currentColor"/></svg>
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
<% if (hasHeadlines) { %>
<script>
  (function () {
    var items = document.querySelectorAll('#headlineTicker .headline-ticker-item');
    if (items.length < 2) return;
    var idx = 0;
    setInterval(function () {
      items[idx].classList.remove('active');
      idx = (idx + 1) % items.length;
      items[idx].classList.add('active');
    }, 4000);
  })();
</script>
<% } %>
<% } %>
