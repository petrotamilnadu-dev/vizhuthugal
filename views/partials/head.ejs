<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' - ' : '' %><%= SITE_NAME %></title>
<link rel="icon" href="/static/images/logo-ta.png">

<!-- Add to Home Screen / PWA support -->
<link rel="manifest" href="/static/manifest.json">
<link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png">
<meta name="theme-color" content="#17233d">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Vizhuthugal">

<%
  var _ogTitle = typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : ((typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' - ' : '') + SITE_NAME_EN);
  var _ogDesc = typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : SITE_TAGLINE;
  var _ogImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : (SITE_URL + '/static/images/logo-ta.png');
  var _ogUrl = typeof ogUrl !== 'undefined' && ogUrl ? ogUrl : CURRENT_URL;
  var _ogType = typeof ogType !== 'undefined' && ogType ? ogType : 'website';
%>
<meta property="og:type" content="<%= _ogType %>">
<meta property="og:site_name" content="<%= SITE_NAME_EN %>">
<meta property="og:title" content="<%= _ogTitle %>">
<meta property="og:description" content="<%= _ogDesc %>">
<meta property="og:image" content="<%= _ogImage %>">
<meta property="og:url" content="<%= _ogUrl %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= _ogTitle %>">
<meta name="twitter:description" content="<%= _ogDesc %>">
<meta name="twitter:image" content="<%= _ogImage %>">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Tamil:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/style.css">
