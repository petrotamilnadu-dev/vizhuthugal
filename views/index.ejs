<!DOCTYPE html>
<html lang="ta">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <%- include('partials/banner', { banner: banners.top }) %>

    <% if (heroMain) { %>
      <section class="hero-grid">
        <a href="/article/<%= heroMain.slug %>" class="hero-main">
          <% if (heroMain.image) { %><img src="<%= heroMain.image %>" alt="<%= heroMain.title %>"><% } %>
          <div class="hero-glow"></div>
          <div class="hero-main-content">
            <% if (heroMain.category_name) { %><span class="card-tag"><%= heroMain.category_name %></span><% } %>
            <h1><%= heroMain.title %></h1>
            <% if (heroMain.summary) { %><p><%= heroMain.summary %></p><% } %>
          </div>
        </a>

        <div class="hero-side">
          <% heroSide.forEach(function(a) { %>
            <a href="/article/<%= a.slug %>" class="hero-side-card">
              <div class="hero-side-img">
                <% if (a.image) { %><img src="<%= a.image %>" alt="<%= a.title %>"><% } else { %><div class="card-img-placeholder"></div><% } %>
              </div>
              <div class="hero-side-text">
                <% if (a.category_name) { %><span class="card-tag card-tag-light"><%= a.category_name %></span><% } %>
                <h3><%= a.title %></h3>
              </div>
            </a>
          <% }); %>
        </div>
      </section>
    <% } else { %>
      <div class="empty-state">
        <h2>இன்னும் செய்திகள் வெளியிடப்படவில்லை</h2>
        <p>Admin panel மூலம் முதல் செய்தியை சேர்க்கவும்.</p>
      </div>
    <% } %>

    <% if (rest.length) { %>
      <h2 class="section-title">சமீபத்திய செய்திகள்</h2>
      <div class="article-grid">
        <% rest.forEach(function(a) { %>
          <%- include('partials/article-card', { a }) %>
        <% }); %>
      </div>
    <% } %>

    <%- include('partials/banner', { banner: banners.infeed }) %>

    <% if (igVideos && igVideos.length) { %>
      <h2 class="section-title">Instagram-ல் புதியவை</h2>
      <div class="instagram-grid">
        <% igVideos.forEach(function(v) { %>
          <blockquote class="instagram-media" data-instgrm-permalink="<%= v.permalink %>" data-instgrm-version="14"></blockquote>
        <% }); %>
      </div>
      <script async src="//www.instagram.com/embed.js"></script>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
